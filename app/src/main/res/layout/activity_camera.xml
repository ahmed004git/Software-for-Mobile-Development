<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1A"
    android:orientation="vertical"
    tools:context=".CameraActivity">

    <!-- Camera Viewfinder Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#C2D1B2">

        <!-- Top Hills / Sun Illustration Background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_alignParentBottom="true"
            android:background="#8FA978" />

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_alignParentBottom="true"
            android:background="#6C8655" />

        <!-- Pale Yellow Sun -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="80dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#FDF0CD" />

        <!-- Top Controls -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="20dp">

            <!-- Sun / Lighting Button -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#60000000"
                android:contentDescription="Lighting"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <!-- Close (X) Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#60000000"
                android:contentDescription="Close"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />
        </RelativeLayout>

        <!-- Bottom Camera Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <!-- Gallery Thumbnail Preview -->
            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#C2B296">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Gallery"
                        android:src="@drawable/ic_photo"
                        app:tint="@color/white" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Flash / Lightning Icon Button -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#60000000"
                android:contentDescription="Flash"
                android:padding="11dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <!-- Shutter Button -->
            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#80FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/white" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Flip Camera Button -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#60000000"
                android:contentDescription="Flip Camera"
                android:padding="11dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <!-- Effects / Smiley Button with Red Dot -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#60000000">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Effects"
                    android:src="@drawable/ic_info_circle"
                    app:tint="@color/white" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_circle_red" />
            </FrameLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- Bottom Mode Selector Bar (Black Background) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#111111"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="TEXT"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="LIVE"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- STORY (Active) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STORY"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="POST"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="BOOMERANG"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>